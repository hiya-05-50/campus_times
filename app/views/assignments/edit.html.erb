<% content_for :head do %>
  <%= stylesheet_link_tag "assignments", "data-turbo-track": "reload" %>
<% end %>

<div class="page-container">
  <a href="<%= course_assignment_path(@course, @assignment) %>" class="back-link">← Back to Assignment</a>
  <h1 class="page-title">Edit Assignment</h1>
  <p class="page-subtitle"><%= @course.name %> (<%= @course.code %>)</p>

  <%= render "form" %>
</div>
