<%= form_with model: [@course, @assignment], class: "resource-form" do |f| %>
  <% if @assignment.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(@assignment.errors.count, "error") %> prevented this assignment from being saved:</h3>
      <ul>
        <% @assignment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <label for="assignment_title" class="form-label">Title</label>
    <%= f.text_field :title, class: "form-input", required: true, placeholder: "Assignment title" %>
  </div>

  <div class="form-group">
    <label for="assignment_description" class="form-label">Description</label>
    <%= f.text_area :description, class: "form-input form-textarea", required: true, rows: 6, placeholder: "Describe the assignment requirements..." %>
  </div>

  <div class="form-row">
    <div class="form-group form-group-half">
      <label for="assignment_deadline" class="form-label">Deadline</label>
      <%= f.datetime_local_field :deadline, class: "form-input", required: true %>
    </div>

    <div class="form-group form-group-half">
      <label for="assignment_max_marks" class="form-label">Maximum Marks</label>
      <%= f.number_field :max_marks, class: "form-input", required: true, min: 1, placeholder: "100" %>
    </div>
  </div>

  <div class="form-group">
    <label class="form-checkbox-label">
      <%= f.check_box :published, class: "form-checkbox" %>
      <span>Publish this assignment (visible to students)</span>
    </label>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <a href="<%= course_assignments_path(@course) %>" class="btn btn-secondary">Cancel</a>
  </div>
<% end %>
