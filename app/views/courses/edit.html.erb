<% content_for :title, "Edit #{@course.name} - Campus Times" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "courses", "data-turbo-track": "reload" %>
<% end %>

<main class="courses-shell">
  <div class="courses-panel" style="max-width: 680px;">
    
    <div style="margin-bottom: 20px; display: flex; justify-content: space-between;">
      <%= link_to "← Back to courses", courses_path, class: "btn-secondary", style: "font-size: 13px; padding: 7px 14px;" %>
      <%= link_to "View Course", @course, class: "btn-secondary", style: "font-size: 13px; padding: 7px 14px;" %>
    </div>

    <header class="courses-header" style="margin-bottom: 28px;">
      <div>
        <p class="courses-eyebrow">COURSE CATALOG</p>
        <h1 style="font-size: 26px;">Edit Course</h1>
        <p>Update information for <%= @course.code %>.</p>
      </div>
    </header>

    <%= render "form", course: @course %>

  </div>
</main>
