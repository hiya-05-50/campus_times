<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Courses</h1>
    <%= link_to "New course", new_course_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="courses" class="min-w-full">
    <% @courses.each do |course| %>
      <div class="bg-white shadow rounded-lg p-6 mt-4">
        <h2 class="text-2xl font-semibold"><%= course.name %> (<%= course.code %>)</h2>
        <p class="text-gray-600 mt-2"><%= truncate(course.description, length: 100) %></p>
        <p class="mt-2 text-sm text-gray-500">
          Faculty: <%= course.faculty ? course.faculty.email : "Not Assigned" %>
        </p>
        <div class="mt-4">
          <%= link_to "Show this course", course, class: "rounded-lg py-2 px-4 bg-gray-100 text-black inline-block font-medium" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
