<% content_for :title, "#{@course.name} - Campus Times" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "courses", "data-turbo-track": "reload" %>
<% end %>

<main class="courses-shell">
  <div class="courses-panel">
    
    <% if notice.present? %>
      <div class="courses-notice" id="notice">
        <span>✓</span> <%= notice %>
      </div>
    <% end %>

    <div style="margin-bottom: 24px;">
      <%= link_to "← Back to all courses", courses_path, class: "btn-secondary", style: "font-size: 13px; padding: 7px 14px;" %>
    </div>

    <div class="course-detail-hero">
      <div class="course-detail-header">
        <div>
          <span class="course-badge"><%= @course.code %></span>
          <h1 class="course-detail-title"><%= @course.name %></h1>
          <p class="course-meta" style="font-size: 14px; margin-top: 8px;">
            Instructor / Faculty ID: <strong><%= @course.faculty_id.present? ? "##{@course.faculty_id}" : "Unassigned" %></strong>
          </p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
          <%= link_to "Edit Course", edit_course_path(@course), class: "btn-secondary" %>
          <%= button_to "Delete", @course, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this course?" }, class: "btn-danger" %>
        </div>
      </div>

      <div class="course-detail-section">
        <h3>Description & Syllabus</h3>
        <div class="course-detail-desc">
          <%= simple_format(@course.description.presence || "No description provided for this course yet.") %>
        </div>
      </div>
    </div>

  </div>
</main>
