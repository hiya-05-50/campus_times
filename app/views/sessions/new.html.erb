<% content_for :head do %>
  <%= stylesheet_link_tag "assignments", "data-turbo-track": "reload" %>
<% end %>

<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Campus Times</h1>
    <h2 class="auth-subtitle">Sign In</h2>

    <% if flash[:alert] %>
      <div class="flash-alert"><%= flash[:alert] %></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="flash-notice"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with url: login_path, method: :post, class: "auth-form" do |f| %>
      <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input type="email" name="email" id="email" class="form-input" required autofocus placeholder="you@example.com">
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input type="password" name="password" id="password" class="form-input" required placeholder="Your password">
      </div>

      <button type="submit" class="btn btn-primary btn-full">Sign In</button>
    <% end %>
  </div>
</div>
