<div class="placement-container">
  <%= stylesheet_link_tag "placements", "data-turbo-track": "reload" %>

  <div style="margin-bottom: 1rem;">
    <%= link_to "← Back to Drive", placement_drive_path(@placement_drive), class: "placement-btn placement-btn-secondary" %>
  </div>

  <div class="placement-header">
    <div>
      <h1>Edit Placement Drive</h1>
      <div class="subtitle">Modify recruitment drive criteria, deadline, or role details.</div>
    </div>
  </div>

  <div class="placement-card">
    <%= render "form", placement_drive: @placement_drive %>
  </div>
</div>
