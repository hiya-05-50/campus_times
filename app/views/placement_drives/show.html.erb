<div class="placement-container">
  <%= stylesheet_link_tag "placements", "data-turbo-track": "reload" %>

  <% if notice.present? %>
    <div class="flash-notice"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="flash-alert"><%= alert %></div>
  <% end %>

  <div style="margin-bottom: 1rem;">
    <%= link_to "← Back to Placement Drives", placement_drives_path, class: "placement-btn placement-btn-secondary" %>
  </div>

  <div class="placement-header">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <h1><%= @placement_drive.title %></h1>
        <% if @placement_drive.open? %>
          <span class="placement-badge badge-open">Open</span>
        <% else %>
          <span class="placement-badge badge-closed">Closed</span>
        <% end %>
      </div>
      <div class="subtitle">
        <%= @placement_drive.company.name %> | <%= @placement_drive.job_role %> | <%= @placement_drive.job_location.presence || "Multiple Locations" %>
      </div>
    </div>
    <div class="placement-nav-links">
      <% if admin_user? %>
        <%= link_to "Edit Drive", edit_placement_drive_path(@placement_drive), class: "placement-btn placement-btn-secondary" %>
        <%= button_to "Delete Drive", placement_drive_path(@placement_drive), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this placement drive?" }, class: "placement-btn placement-btn-danger" %>
      <% end %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <div class="placement-card">
      <h3>Job Description</h3>
      <p style="white-space: pre-line; color: var(--placement-gray-700); line-height: 1.6;">
        <%= @placement_drive.job_description.presence || "No detailed job description provided." %>
      </p>

      <h4 style="margin-top: 1.5rem;">Drive Overview</h4>
      <div class="placement-meta" style="font-size: 0.9rem;">
        <div><strong>Company:</strong> <%= @placement_drive.company.name %></div>
        <div><strong>Job Role:</strong> <%= @placement_drive.job_role %></div>
        <div><strong>Employment Type:</strong> <%= @placement_drive.employment_type %></div>
        <div><strong>Package / Stipend:</strong> <%= @placement_drive.ctc_or_stipend.presence || "As per company standards" %></div>
        <div><strong>Target Graduation Year:</strong> Class of <%= @placement_drive.graduation_year %></div>
        <div><strong>Eligible Departments:</strong> <%= @placement_drive.departments.any? ? @placement_drive.departments.map(&:name).join(", ") : "All Departments" %></div>
        <div><strong>Application Deadline:</strong> <%= @placement_drive.application_deadline.strftime("%A, %B %d, %Y at %I:%M %p") %></div>
      </div>
    </div>

    <div>
      <% if student_user? %>
        <div class="eligibility-box">
          <h3 style="margin-top: 0;">Eligibility Assessment</h3>
          <p style="font-size: 0.85rem; color: var(--placement-gray-600); margin-bottom: 1rem;">
            Automated check against recruitment criteria for <strong><%= current_user.name %></strong>:
          </p>

          <% @eligibility.conditions.each do |condition| %>
            <div class="eligibility-condition <%= condition.passed? ? 'passed' : 'failed' %>">
              <div class="condition-icon" style="color: <%= condition.passed? ? 'var(--placement-success)' : 'var(--placement-danger)' %>;">
                <%= condition.passed? ? "✓" : "✕" %>
              </div>
              <div class="condition-details">
                <div class="condition-title" style="color: <%= condition.passed? ? 'var(--placement-success)' : 'var(--placement-danger)' %>;">
                  <%= condition.name %>: <%= condition.passed? ? "Passed" : "Failed" %>
                </div>
                <p class="condition-text"><%= condition.explanation %></p>
                <div style="font-size: 0.75rem; color: var(--placement-gray-600); margin-top: 0.2rem;">
                  Required: <%= condition.requirement %> | Actual: <%= condition.actual %>
                </div>
              </div>
            </div>
          <% end %>

          <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--placement-gray-200);">
            <% if @existing_application.present? %>
              <div style="margin-bottom: 1rem;">
                <span class="placement-badge badge-<%= @existing_application.status %>" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
                  Application Status: <%= @existing_application.status.capitalize %>
                </span>
                <div style="font-size: 0.8rem; color: var(--placement-gray-600); margin-top: 0.5rem;">
                  Applied on <%= @existing_application.applied_at&.strftime("%b %d, %Y") || @existing_application.created_at.strftime("%b %d, %Y") %>
                  <% if @existing_application.withdrawn? %>
                    | Withdrawn on <%= @existing_application.withdrawn_at&.strftime("%b %d, %Y") %>
                  <% end %>
                </div>
              </div>

              <% if @existing_application.can_withdraw? %>
                <%= button_to "Withdraw Application",
                              withdraw_placement_application_path(@existing_application),
                              method: :patch,
                              data: { turbo_confirm: "Are you sure you want to withdraw your application? This action cannot be undone." },
                              class: "placement-btn placement-btn-danger",
                              style: "width: 100%;" %>
              <% end %>
            <% elsif @eligibility.eligible? && @placement_drive.open? %>
              <%= form_with url: placement_drive_applications_path(@placement_drive), method: :post do |f| %>
                <div style="margin-bottom: 0.75rem;">
                  <%= f.label :notes, "Optional Note to Recruiter", style: "font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.25rem;" %>
                  <%= f.text_area :notes, name: "placement_application[notes]", rows: 2, class: "placement-form-input", placeholder: "Portfolio link, skills, or statement of interest...", style: "width: 100%; border: 1px solid var(--placement-gray-200); border-radius: 6px; padding: 0.5rem; font-size: 0.85rem;" %>
                </div>
                <%= f.submit "Submit Application", class: "placement-btn placement-btn-success", style: "width: 100%;" %>
              <% end %>
            <% elsif !@placement_drive.open? %>
              <div class="flash-alert" style="margin: 0;">
                This placement drive is closed. Applications are no longer accepted.
              </div>
            <% else %>
              <div class="flash-alert" style="margin: 0; font-size: 0.85rem;">
                <strong>Application Blocked:</strong> You do not meet the eligibility requirements for this drive.
              </div>
              <button class="placement-btn placement-btn-secondary disabled" disabled style="width: 100%; margin-top: 0.75rem;">
                Ineligible to Apply
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="placement-card">
        <h4 style="margin-top: 0;">Recruiter Contact</h4>
        <div class="placement-meta">
          <div><strong>Person:</strong> <%= @placement_drive.company.contact_person.presence || "Campus Relations Team" %></div>
          <div><strong>Email:</strong> <%= @placement_drive.company.contact_email.presence || "campus@company.com" %></div>
          <div><strong>Website:</strong> <%= safe_external_link(@placement_drive.company.website, style: "color: var(--placement-primary);") || @placement_drive.company.website %></div>
        </div>
      </div>
    </div>
  </div>

  <% if admin_user? %>
    <div class="placement-card" style="margin-top: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0;">Applicant Inspection (<%= @applicants&.count || 0 %> Total)</h3>
        <div style="display: flex; gap: 0.5rem;">
          <span class="placement-badge badge-applied">Applied: <%= @applicants&.count { |a| a.status == 'applied' } || 0 %></span>
          <span class="placement-badge badge-shortlisted">Shortlisted: <%= @applicants&.count { |a| a.status == 'shortlisted' } || 0 %></span>
          <span class="placement-badge badge-selected">Selected: <%= @applicants&.count { |a| a.status == 'selected' } || 0 %></span>
        </div>
      </div>

      <% if @applicants.blank? %>
        <p style="color: var(--placement-gray-600); text-align: center; padding: 2rem;">No students have applied to this placement drive yet.</p>
      <% else %>
        <div style="overflow-x: auto;">
          <table class="placement-table">
            <thead>
              <tr>
                <th>Student</th>
                <th>Department</th>
                <th>CGPA</th>
                <th>Backlogs</th>
                <th>Batch</th>
                <th>Applied Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% @applicants.each do |application| %>
                <tr>
                  <td>
                    <strong><%= application.user.name %></strong>
                    <div style="font-size: 0.75rem; color: var(--placement-gray-600);"><%= application.user.email %></div>
                  </td>
                  <td><%= application.user.department&.name || "N/A" %></td>
                  <td><strong><%= application.user.cgpa %></strong></td>
                  <td><%= application.user.backlogs_count %></td>
                  <td><%= application.user.graduation_year %></td>
                  <td><%= application.applied_at&.strftime("%b %d, %Y") || application.created_at.strftime("%b %d, %Y") %></td>
                  <td>
                    <span class="placement-badge badge-<%= application.status %>">
                      <%= application.status.capitalize %>
                    </span>
                  </td>
                  <td>
                    <%= form_with model: application, url: placement_application_path(application), method: :patch, local: true do |f| %>
                      <div style="display: flex; gap: 0.25rem; align-items: center;">
                        <%= f.select :status,
                                     PlacementApplication::STATUSES.map { |s| [s.capitalize, s] },
                                     {},
                                     { style: "padding: 0.25rem 0.4rem; font-size: 0.8rem; border-radius: 4px; border: 1px solid var(--placement-gray-200);" } %>
                        <%= f.submit "Update", class: "placement-btn placement-btn-secondary", style: "padding: 0.25rem 0.5rem; font-size: 0.75rem;" %>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
